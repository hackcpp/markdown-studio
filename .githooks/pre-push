#!/bin/sh
set -eu

hook_dir=$(dirname "$0")
checked=no

while read -r local_ref local_oid remote_ref remote_oid; do
  # 删除远端引用时没有提交需要检查。
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  commit=$(git rev-parse --verify --quiet "$local_oid^{commit}") || continue
  printf '检查代码格式：%s\n' "$local_ref"
  sh "$hook_dir/check-format" "$commit"
  checked=yes
done

if [ "$checked" = yes ]; then
  npm test </dev/null
fi
